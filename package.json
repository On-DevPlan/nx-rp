{
  "name": "nx-rp",
  "version": "0.8.2",
  "description": "nx-rp（npx-repo）—— 项目外部上下文信息管理：doc / deps 等域，CLI + Web 面板同源，按 cwd 自动隔离 scope",
  "type": "module",
  "bin": {
    "nx-rp": "bin/nx-rp.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "vite build && node scripts/link-local.mjs --auto",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/nx-rp.mjs serve --no-open",
    "start": "pnpm run build && node bin/nx-rp.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && node tests/smoke.mjs && node --test tests/unit/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/On-DevPlan/nx-rp.git"
  },
  "homepage": "https://github.com/On-DevPlan/nx-rp#readme",
  "bugs": {
    "url": "https://github.com/On-DevPlan/nx-rp/issues"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "CHANGELOG.md"
  ],
  "prepublishOnly": "pnpm run build && pnpm test",
  "keywords": [
    "cli",
    "web-panel",
    "dependency-graph",
    "agent-tools",
    "skills",
    "npx"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@viz-js/viz": "^3.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}